using Gtk 4.0;
using Adw 1;

template $KaoriDownloadDialog : Adw.Dialog {
  title: _("Download");
  content-width: 420;
  content-height: 585;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        title: _("Quick select");

        Adw.WrapBox {
          line-spacing: 6;
          child-spacing: 6;
          justify: fill;

          Gtk.Button {
            label: _("Next");
            action-name: "dialog.preset";
            action-target: "1";
          }

          Gtk.Button {
            label: _("Next 5");
            action-name: "dialog.preset";
            action-target: "5";
          }

          Gtk.Button {
            label: _("Next 10");
            action-name: "dialog.preset";
            action-target: "10";
          }

          Gtk.Button {
            label: _("Next 25");
            action-name: "dialog.preset";
            action-target: "25";
          }

          Gtk.Button {
            label: _("Unread");
            action-name: "dialog.preset";
            action-target: "0";
          }

          Gtk.Button {
            label: _("All");
            action-name: "dialog.preset";
            action-target: "-1";
          }
        }
      }

      Adw.PreferencesGroup {
        title: _("Range");

        Adw.ComboRow {
          title: _("From chapter");
          enable-search: true;
          expression: expr item as <Gtk.StringObject>.string;
          model: bind template.names;
          selected: bind template.from-index bidirectional;
        }

        Adw.ComboRow {
          title: _("To chapter");
          enable-search: true;
          expression: expr item as <Gtk.StringObject>.string;
          model: bind template.names;
          selected: bind template.to-index bidirectional;
        }

        Adw.SwitchRow {
          title: _("Skip read chapters");
          active: bind template.skip-read bidirectional;
        }
      }

      Adw.PreferencesGroup {
        Adw.ActionRow {
          title: bind template.summary;
        }
      }
    };

    [bottom]
    Gtk.Box {
      margin-start: 12;
      margin-end: 12;
      margin-top: 12;
      margin-bottom: 12;

      Gtk.Button {
        hexpand: true;
        styles ["suggested-action", "pill"]
        label: _("Download");
        sensitive: bind template.can-download;
        action-name: "dialog.download";
      }
    }
  };
}